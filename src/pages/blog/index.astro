---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatsSidebar from '../../components/StatsSidebar.astro';
import { withBase } from '../../lib/site';
import githubData from '../../data/github-data.json';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout
    title="Blog - COFF0XC"
    description="COFF0XC Blog - Security Research & Tech Articles"
    path="blog/"
>
    <div class="content-left">
        <section id="blog-list">
            <header class="blog-header">
                <h1 data-i18n="blog.title">Blog</h1>
                <p data-i18n="blog.subtitle">Security Research & Tech Articles</p>
            </header>
            {posts.length > 0 ? (
                <ul class="post-list">
                    {posts.map((post) => (
                        <li class="post-item">
                            <h2>
                                <a
                                    href={withBase(`blog/${post.id}/`)}
                                    data-zh={post.data.title}
                                    data-en={post.data.titleEn}
                                >{post.data.titleEn}</a>
                            </h2>
                            <div class="post-meta">
                                {post.data.date.toISOString().slice(0, 10)}
                                {post.data.type === 'report' && (
                                    <span class="post-type-tag report" data-i18n="blog.typeReport">Report</span>
                                )}
                                {post.data.tags.map((tag) => <span class="post-tag">{tag}</span>)}
                            </div>
                            <p
                                class="post-summary"
                                data-zh={post.data.summary}
                                data-en={post.data.summaryEn}
                            >{post.data.summaryEn}</p>
                        </li>
                    ))}
                </ul>
            ) : (
                <p class="activity-note" data-i18n="blog.empty">Nothing published yet — check back soon.</p>
            )}
        </section>
    </div>
    <StatsSidebar stats={githubData.stats} />
</BaseLayout>
