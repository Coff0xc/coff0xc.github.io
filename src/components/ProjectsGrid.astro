---
import { i18n } from '../data/i18n';

interface Project {
  name: string;
  description: string;
  url: string;
  stars: number;
  forks: number;
  language: string;
  updatedAt: string;
}
interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---
<section id="projects">
    <h2 data-i18n="projects.title">Select Projects</h2>
    {projects.length > 0 ? (
        <div class="item-list">
            {projects.map((project) => (
                <div class="item-row">
                    <div class="item-heading">
                        <h3><a href={project.url} target="_blank" rel="noopener">{project.name}</a></h3>
                        {project.language !== 'Unknown' && <span class="item-lang">{project.language}</span>}
                    </div>
                    <p>{project.description || <span data-i18n="common.noDescription">{i18n.en.common.noDescription}</span>}</p>
                    {project.stars > 0 && <span class="item-stars">★ {project.stars}</span>}
                </div>
            ))}
        </div>
    ) : (
        <p class="activity-note" data-i18n="projects.empty">Could not fetch project data at build time — try again shortly.</p>
    )}
</section>
